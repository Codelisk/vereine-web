---
import Icon from '@/components/Icon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { APP } from '@/config/site';
---

<BaseLayout>
  <main class="page">
    <header class="page-header">
      <h1>{APP.name}</h1>
      <p class="subdued">{APP.description}</p>
    </header>

    <section class="empty-state" aria-labelledby="bald">
      <span class="empty-state-icon">
        <Icon name="soccer-ball" />
      </span>
      <h2 id="bald">Bald geht es los</h2>
      <p>Hier verwaltest du bald Mitglieder, Termine und Beiträge deines Vereins.</p>
    </section>
  </main>
</BaseLayout>
